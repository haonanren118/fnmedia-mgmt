appname               = fnmedia-mgmt
version               = @VERSION@
display_name          = fnMedia扩展管理
desc                  = 飞牛影视在线资源扩展管理端：零侵入可逆接管官方影视入口，支持原生搜索聚合、豆瓣热门榜单四库与资源站海量分类五库（电影/剧集/动漫/综艺/短剧，无限滚动、点开即播）、m3u8/mp4 代理播放、多线路切换、噪音过滤、播放记录与智能续播，内置应用内管理页。
platform              = @PLATFORM@
source                = thirdparty
maintainer            = haonanren118
maintainer_url        = https://github.com/haonanren118
os_min_version        = 1.2.0
install_dep_apps      = trim.media
desktop_uidir         = ui
desktop_applaunchname = fnmedia-mgmt.main
checkport             = false
micro_app             = true
